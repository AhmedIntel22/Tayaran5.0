<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only microphone access is needed for recording and speech recognition. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===== ATELIER 4 : ADDED - needed by SpeechRecognizer on Android 11+ ===== -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tayaran">

        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity"
            android:exported="false" />

        <!-- Not an external entry point. The app can still launch Tayra outbound. -->
        <activity android:name=".ProfileActivity"
            android:exported="false" />

        <activity android:name=".FlightSearchActivity"
            android:exported="false" />

        <activity android:name=".BookingConfirmationActivity"
            android:exported="false" />

        <!-- ATELIER 4 : ADDED - screen that launches the three services -->
        <activity android:name=".ServicesActivity"
            android:exported="false" />

        <!-- ===== ATELIER 4 : ADDED - the three unbound services ===== -->
        <service
            android:name=".services.SimulationService"
            android:exported="false" />

        <service
            android:name=".services.EnregistrementService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".services.AnalyseService"
            android:exported="false" />

        <!-- ATELIER 4 : ADDED - same action as AnalyseService.ACTION_PREFERENCES -->
        <receiver
            android:name=".services.RetourReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.tayaran.PREFERENCES_ANALYSEES" />
            </intent-filter>
        </receiver>

        <!-- Lets AppCompat remember the chosen app language on Android 12 and below -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>