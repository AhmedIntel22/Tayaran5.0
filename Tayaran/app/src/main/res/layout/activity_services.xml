<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal|center_vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/services_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/syncButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_sync_flights"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="#D4AF37"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voiceNoteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_voice_note"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="12dp"
            app:backgroundTint="#D4AF37"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/analyseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_voice_analyse"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="12dp"
            app:backgroundTint="#D4AF37"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runAllButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_run_all"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="12dp"
            app:backgroundTint="#D4AF37"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_last_analysis"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/lastAnalysisText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="28dp"
            app:backgroundTint="#D4AF37"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>